# Disalin ke pengaturan Cloudflare. Jangan taruh rahasia sungguhan di repo.
#
# Binding, bukan variabel env. Nama harus persis.
#   SESSIONS  KV   sesi Bearer, cache CSV Google Sheet, dan salinan isian
#             bila APPS_SCRIPT_URL kosong.
#             namespace preview: 3b0c0af482734b8ba8710a5f60412ae5
#
# Web app Apps Script (Execute as: Me, akses Anyone). Kosongkan URL di preview
# sebelum akun Google siap; API memakai KV. Jangan taruh rahasia sungguhan.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
#
# Runtime Pages, opsional. Origin publik server Node lama, tanpa slash akhir
# dan tanpa path. Contoh: https://sinta-padi-api.example.com
# Diabaikan bila binding SESSIONS ada.
API_ORIGIN=
#
# Build frontend, opsional. Kosongkan di Cloudflare Pages agar browser
# memanggil /api di origin yang sama.
# Isi hanya jika browser harus memanggil API lintas origin (butuh CORS di server).
API_BASE=
#
# Hanya server Node lokal. Tidak dibaca oleh Cloudflare Pages.
# PORT=8200
